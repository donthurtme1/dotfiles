[{
	//"output": "DP-1",
	"position": "top",
	"height": 28,
	"reload_style_on_change": true,
	"fixed-center": false,
	"expand-center": true,

	"spacing": 4,
	"modules-left": [
		"dwl/tags",
		"dwl/window#layout",
		"custom/sep",
		"custom/sep"
	],
	"modules-center": [
		"dwl/window#title"
	],
	"modules-right": [
		"custom/sep",
		"custom/sep",
		/*"mpd",
		"custom/sep",*/
		"battery",
		"custom/sep",
		"wireplumber",
		"custom/sep",
		"clock"
	],

	"dwl/tags": {
		"num-tags": 10,
		"tag-labels": ["1","2","3","4","5","6","7","8","9","0"]
	},
	"dwl/window#layout": {
		"format": "[{layout}]",
		"tooltip": false
	},

	"dwl/window#title": {
		"format": " {title} ",
		"tooltip": false
	},

	"battery": {
		"format": " {icon} {capacity}% ",
		"format-icons": {
			"default": ["󱊡", "󱊢", "󱊣"],
			"charging": ["󱊤", "󱊥", "󱊦"]
		},
		"tooltip": false
	},
	"cava": {
		"method": "raw",
		"bars": 12,
		"format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
		"hide_on_silence": false,
		"tooltip": false
	},
	"mpd": {
		"format": " {stateIcon}{artist} - {title} ",
		"state-icons" : {
			"playing": "",
			"paused": "Paused: "
		},
		"max-length": 36,
		"tooltip": false
	},
	"network": {
		"format": " NET connecting... ",
		"format-disconnected": " NET disconnected ",
		"format-wifi": " WIFI {signalStrength}% ",
		"format-ethernet": " NET {bandwidthTotalBytes} ",
		"interval": 8,
		"max-length": 19,
		"tooltip": false
	},
	"wireplumber": {
		"format": " {icon} {volume}% ",
		"format-icons": ["", ""],
		"tooltip": false
	},
	"clock": {
		"format": " {:%a %d/%m/%y - %R %Z} ",
		"tooltip": false
	},

	"custom/discord": {
		"format": " {icon} ",
		"format-icons": [" ", ""]
	},
	"custom/sep": {
		"format" : "│",
		"interval" : 0,
		"tooltip": false
	}
}]
